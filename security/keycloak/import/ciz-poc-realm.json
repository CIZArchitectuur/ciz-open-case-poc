{
  "realm": "ciz-poc",
  "enabled": true,
  "displayName": "CIZ Open Case PoC",
  "registrationAllowed": false,
  "loginWithEmailAllowed": false,
  "roles": {
    "realm": [
      { "name": "ciz-medewerker", "description": "Lokale PoC-rol voor CIZ-registratie en verzending" },
      { "name": "beoordelaar", "description": "Lokale PoC-rol voor triage en inhoudelijke beoordeling" }
    ]
  },
  "clientScopes": [
    {
      "name": "ciz-api-audience",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true", "display.on.consent.screen": "false" },
      "protocolMappers": [
        {
          "name": "ciz-api audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "ciz-api",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "ciz-frontend",
      "name": "CIZ PoC browser application",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["http://localhost:3000/oidc/callback", "http://localhost:5173/oidc/callback"],
      "webOrigins": ["http://localhost:3000", "http://localhost:5173"],
      "attributes": {
        "post.logout.redirect.uris": "http://localhost:3000/aanvrager##http://localhost:5173/aanvrager"
      },
      "defaultClientScopes": ["ciz-api-audience"],
      "protocolMappers": [
        {
          "name": "CIZ PoC role claim",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "usermodel.realmRoleMapping.rolePrefix": "",
            "multivalued": "true",
            "claim.name": "ciz_roles",
            "jsonType.label": "String",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "userinfo.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "ciz-api",
      "name": "CIZ PoC API resource server",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "bearerOnly": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "defaultClientScopes": []
    },
    {
      "clientId": "ciz-test-harness",
      "name": "Local automated test harness only",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "test-harness-local-only",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "defaultClientScopes": ["ciz-api-audience"],
      "protocolMappers": [
        {
          "name": "CIZ PoC role claim",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "usermodel.realmRoleMapping.rolePrefix": "",
            "multivalued": "true",
            "claim.name": "ciz_roles",
            "jsonType.label": "String",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "userinfo.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "ciz.medewerker",
      "enabled": true,
      "email": "ciz.medewerker@poc.invalid",
      "emailVerified": true,
      "firstName": "PoC",
      "lastName": "CIZ-medewerker",
      "credentials": [{ "type": "password", "value": "ciz-test-only", "temporary": false }],
      "realmRoles": ["ciz-medewerker"]
    },
    {
      "username": "beoordelaar",
      "enabled": true,
      "email": "beoordelaar@poc.invalid",
      "emailVerified": true,
      "firstName": "PoC",
      "lastName": "Beoordelaar",
      "credentials": [{ "type": "password", "value": "beoordelaar-test-only", "temporary": false }],
      "realmRoles": ["beoordelaar"]
    }
  ]
}
