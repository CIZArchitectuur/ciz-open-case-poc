# Copy to ignored .env. Never put credentials in Compose, Git or frontend builds.
OPENAI_API_KEY=
CLOUD_LLM_BASE_URL=https://api.openai.com/v1
CLOUD_LLM_MODEL=gpt-6.1-sol
CLOUD_LLM_SUPPORTS_VISION=true
# Local CPU orchestrator URL. Compose wiring will be enabled after the local
# RobBERT checkpoint is installed; leave empty until then.
IMPAIRMENT_UPSTREAM_URL=
# Required by the local upstream /process-file API when enabled. Never commit a token.
IMPAIRMENT_UPSTREAM_TOKEN=
IMPAIRMENT_PIPELINE_VERSION=unverified
# Exact local checkpoint/release identifier.
IMPAIRMENT_CLASSIFIER_MODEL=
