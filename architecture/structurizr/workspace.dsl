workspace "CIZ Open Case PoC" "Container-based ordinary Wlz application flow" {
    model {
        applicant = person "Aanvrager" "Submits and follows a fictional Wlz application."
        careProvider = person "Zorgaanbieder" "Uses the same application flow and adds supporting documents for the client."
        reviewer = person "Onderzoeker" "Checks applications and document contents, requests supplements, triages, investigates and records decisions and dispatch."
        employee = person "AO" "Uploads received documents to existing cases; no control or process-task authority."
        impairmentPipeline = softwareSystem "Internal stoornissen pipeline" "Existing operator-managed RobBERT classifier, curation and Ernst services; all outputs are proposals."
        pdok = softwareSystem "PDOK Locatieserver" "Public Dutch address lookup; only used for optional suggestions."
        system = softwareSystem "CIZ Open Case PoC" {
            frontend = container "Frontend" "Applicant portal and role-specific CIZ/reviewer work queues" "React, TypeScript, Nginx"
            identityProvider = container "Identity provider" "Authenticates CIZ employees and reviewers using OIDC Authorization Code with PKCE" "Keycloak locally; DEZI-ready OIDC configuration"
            gateway = container "API gateway" "Routes synchronous browser and service API calls" "Kong Gateway, DB-less"
            caseService = container "Case service" "Owns person, address, application and case records; maps Operaton tasks and status events" "Java 21, Quarkus, generated OpenAPI clients"
            caseDatabase = container "Case database" "Stores case-service state only" "PostgreSQL" "Database"
            basService = container "BAS service" "Owns OCR, document extraction, dossier analysis and source-linked human reviews; starts after committed submission events" "Java 21, Quarkus, Kafka"
            basDatabase = container "BAS database" "Owns analysis versions, source references and audit" "PostgreSQL" "Database"
            assessmentService = container "Assessment service" "Owns versioned policy and medical evaluations, decisions and dispatch audit" "Java 21, Quarkus, generated OpenAPI"
            assessmentDatabase = container "Assessment database" "Owns evaluations and decisions with full provenance" "PostgreSQL" "Database"
            kafka = container "Event broker" "Distributes application status, document receipts and definitive submission snapshots" "Kafka protocol, Redpanda locally"
            statusBatch = container "Administrative support batch mock" "Consumes status events and aggregates a batch for a mocked hand-off" "Apache Camel Quarkus"
            workflow = container "Workflow engine" "Owns process instances and user tasks" "Operaton 2.1, BPMN"
            workflowStarter = container "Workflow start adapter" "Durably consumes submitted applications and starts one process per case" "Java 21, Quarkus, Kafka, generated OpenAPI"
            workflowInbox = container "Workflow receipt database" "Owns asynchronous workflow-start receipts and retry state" "PostgreSQL" "Database"
            workflowDatabase = container "Workflow database" "Stores Operaton state only" "PostgreSQL" "Database"
            policyService = container "Policy service" "Executes versioned rules using RegelRecht" "RegelRecht"
            addressAdapter = container "Address validation adapter" "Looks up Dutch postcode and house number suggestions; never blocks manual entry" "Apache Camel Quarkus, PDOK Locatieserver"
            structuringAdapter = container "Document structuring adapter" "Submits PDFs and polls normalized untrusted OCR results; never evaluates policy" "Apache Camel Quarkus"
            impairmentAdapter = container "Impairment analysis adapter" "Analyses original classification units at dossier level and retains source provenance and severity proposals" "Apache Camel Quarkus, private upstream HTTP API"
            pipelineMock = container "Document pipeline mock" "Simulates the internal document pipeline HTTP API; does not perform OCR" "Python, local test only"
            documentService = container "Document service" "Owns supporting-document metadata and uses Camel routes for S3 object transfer" "Java 21, Quarkus, Apache Camel"
            documentDatabase = container "Document database" "Stores document metadata only" "PostgreSQL" "Database"
            objectStorage = container "S3 object storage" "Stores private binary documents" "S3 API, MinIO built from pinned upstream source locally" "Database"
            telemetry = container "Telemetry pipeline" "Receives and exports traces while removing sensitive request attributes" "OpenTelemetry Collector, Tempo"
            dashboard = container "Observability dashboard" "Shows provisioned service and workflow traces" "Grafana"
        }
        applicant -> frontend "Submits and follows applications" "HTTPS"
        careProvider -> frontend "Submits applications and requested supporting documents for clients" "HTTPS"
        reviewer -> frontend "Signs in, checks dossiers, reviews findings and completes all staff tasks" "OIDC / HTTPS"
        employee -> frontend "Signs in and uploads received documents" "OIDC / HTTPS"
        frontend -> identityProvider "Authenticates staff; tokens held in memory" "OIDC Authorization Code + PKCE"
        frontend -> gateway "Calls public case, person and task APIs" "JSON and binary/HTTP"
        gateway -> caseService "Routes case, person and task APIs" "HTTP, OpenAPI"
        caseService -> gateway "Calls workflow, rules and document APIs" "HTTP, documented API contracts"
        caseService -> gateway "Requests optional address lookup" "HTTP, OpenAPI"
        caseService -> caseDatabase "Reads and writes its own data" "JDBC"
        caseService -> kafka "Publishes and consumes outbox-backed status events" "Kafka, AsyncAPI"
        caseService -> kafka "Publishes document receipts and definitive submission snapshots" "Kafka, AsyncAPI"
        basService -> kafka "Consumes definitive submission events idempotently" "Kafka, AsyncAPI"
        gateway -> basService "Routes extraction and dossier analysis APIs" "HTTP, OpenAPI"
        gateway -> assessmentService "Routes assessment, decision and history APIs" "HTTP, OpenAPI"
        basService -> gateway "Calls document, extraction and impairment adapters" "HTTP, OpenAPI"
        basService -> basDatabase "Reads and writes its own analysis state" "JDBC"
        assessmentService -> assessmentDatabase "Reads and writes its own records" "JDBC"
        basService -> telemetry "Exports analysis traces" "OTLP"
        assessmentService -> telemetry "Exports assessment traces" "OTLP"
        statusBatch -> kafka "Consumes and batches status changes" "Kafka, AsyncAPI"
        gateway -> workflow "Routes workflow API calls" "JSON/HTTP, Operaton REST"
        kafka -> workflowStarter "Delivers submitted applications in an independent consumer group" "Kafka, ApplicationSubmitted"
        workflowStarter -> workflowInbox "Stores receipts and retry state" "JDBC"
        workflowStarter -> gateway "Checks history and starts the process asynchronously" "HTTP, generated Operaton client"
        workflowStarter -> telemetry "Exports correlated workflow-start traces" "OTLP"
        workflow -> workflowDatabase "Reads and writes its own state" "JDBC"
        gateway -> documentService "Routes document API calls" "HTTP, generated OpenAPI client"
        gateway -> policyService "Routes policy API calls" "HTTP, generated OpenAPI client"
        gateway -> addressAdapter "Routes postcode lookup calls" "HTTP, generated OpenAPI client"
        gateway -> structuringAdapter "Routes internal document extraction API calls" "HTTP, OpenAPI"
        gateway -> impairmentAdapter "Routes dossier analysis jobs" "HTTP, OpenAPI"
        impairmentAdapter -> impairmentPipeline "Sends original document units; receives RobBERT/Ernst proposals" "HTTP, documented upstream subset"
        impairmentAdapter -> telemetry "Exports adapter traces without medical payloads" "OTLP"
        structuringAdapter -> gateway "Calls internal pipeline route (private external API when configured)" "HTTP, documented integration subset"
        gateway -> pipelineMock "Routes pipeline submissions and result polling" "HTTP, upstream API subset"
        structuringAdapter -> telemetry "Exports Camel adapter traces without document content" "OTLP"
        addressAdapter -> pdok "Looks up postcode and house number" "HTTPS"
        documentService -> documentDatabase "Reads and writes its own metadata" "JDBC"
        documentService -> objectStorage "Stores and retrieves document bytes through Camel S3 routes" "S3 API"
        frontend -> telemetry "Exports browser traces without personal or case payloads" "OTLP"
        gateway -> telemetry "Exports gateway traces" "OTLP"
        caseService -> telemetry "Exports API and workflow-adapter traces" "OTLP"
        documentService -> telemetry "Exports document API traces" "OTLP"
        addressAdapter -> telemetry "Exports provider-adapter traces" "OTLP"
        statusBatch -> telemetry "Exports batch-processing traces" "OTLP"
        telemetry -> dashboard "Provides trace data" "OTLP / Tempo datasource"
    }
    views {
        container system "Containers" {
            include *
            autoLayout lr 500 450
        }
    }
}
